generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Profile {
  ADULT
  CHILD
}

enum Realm {
  FAMILY
  WORK
}

enum ImprovNature {
  MIXTE
  COMPAREE
}

enum ImprovDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ModuleStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum LessonKind {
  QUEST
  BOSS
  FREE
  CEREMONY
}

enum ProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                       Int                       @id @default(autoincrement())
  email                    String                    @unique
  username                 String?                   @unique
  firstName                String
  password                 String
  role                     Role                      @default(MEMBER)
  profile                  Profile                   @default(ADULT)
  mustChangePassword       Boolean                   @default(false)
  avatarData               String?                   @db.Text // data:image/webp;base64,... (Phase 3)
  avatarUpdatedAt          DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  apps                     UserApp[]
  modules                  ModuleAccess[]
  progress                 Progress[]
  badges                   UserBadge[]
  improvSessions           ImprovSession[]
  kazChatSessions          KazChatSession[]
  pushSubscriptions        PushSubscription[]
  messagerieParticipations ConversationParticipant[]
  messagerieMessages       Message[]
  messageReactions         MessageReaction[]
  messageReads             MessageRead[]
  fridayConversations      FridayConversation[]
  dropAccesses             DropAccess[]
  dropScores               DropScore[]
}

model App {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  description String?
  url         String?
  icon        String
  color       String
  isActive    Boolean   @default(true)
  isMockup    Boolean   @default(true)
  realm       Realm     @default(FAMILY)
  createdAt   DateTime  @default(now())
  users       UserApp[]
}

model UserApp {
  id        Int      @id @default(autoincrement())
  userId    Int
  appId     Int
  hasAccess Boolean  @default(true)
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
}

// ============ ÉDUCATIF — architecture modulaire =============

model Module {
  id          Int            @id @default(autoincrement())
  slug        String         @unique
  title       String
  subtitle    String?
  description String?
  coverColor  String?
  coverIcon   String?
  version     String         @default("1.0.0")
  language    String         @default("fr-CA")
  avatarKey   String?
  status      ModuleStatus   @default(ACTIVE)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  lessons     Lesson[]
  accesses    ModuleAccess[]
}

model ModuleAccess {
  id         Int      @id @default(autoincrement())
  userId     Int
  moduleId   Int
  hasAccess  Boolean  @default(true)
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model Lesson {
  id         Int        @id @default(autoincrement())
  moduleId   Int
  slug       String
  chapter    Int        @default(1)
  order      Int        @default(0)
  kind       LessonKind @default(QUEST)
  title      String
  subtitle   String?
  conceptKey String?
  data       Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses Progress[]

  @@unique([moduleId, slug])
  @@index([moduleId, chapter, order])
}

model Progress {
  id           Int            @id @default(autoincrement())
  userId       Int
  lessonId     Int
  status       ProgressStatus @default(LOCKED)
  stars        Int            @default(0)
  hintsUsed    Int            @default(0)
  attempts     Int            @default(0)
  xpEarned     Int            @default(0)
  savedCode    String?
  firstDoneAt  DateTime?
  lastPlayedAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

model Badge {
  id       Int         @id @default(autoincrement())
  slug     String      @unique
  title    String
  icon     String
  criteria Json
  users    UserBadge[]
}

model UserBadge {
  id       Int      @id @default(autoincrement())
  userId   Int
  badgeId  Int
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ============ IMPRO ENGINE =============

model ImprovCategory {
  id                 Int              @id @default(autoincrement())
  slug               String           @unique
  name               String
  shortDescription   String?
  rulesDescription   String?
  allowedNatures     ImprovNature[]
  minPlayers         Int              @default(1)
  maxPlayers         Int              @default(6)
  minDurationSec     Int              @default(60)
  maxDurationSec     Int              @default(300)
  defaultDurationSec Int              @default(180)
  caucusAllowed      Boolean          @default(true)
  defaultCaucusSec   Int              @default(20)
  themeRequired      Boolean          @default(true)
  constraintsAllowed Boolean          @default(true)
  difficulty         ImprovDifficulty @default(MEDIUM)
  practiceCompatible Boolean          @default(true)
  gameCompatible     Boolean          @default(true)
  tags               String[]         @default([])
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  themes             ImprovTheme[]
}

model ImprovTheme {
  id         Int              @id @default(autoincrement())
  slug       String           @unique
  name       String
  categoryId Int?
  category   ImprovCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  difficulty ImprovDifficulty @default(MEDIUM)
  tags       String[]         @default([])
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
}

model ImprovConstraint {
  id          Int              @id @default(autoincrement())
  slug        String           @unique
  name        String
  description String?
  difficulty  ImprovDifficulty @default(MEDIUM)
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
}

model ImprovSession {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String
  createdAt DateTime      @default(now())
  rounds    ImprovRound[]

  @@index([userId])
}

model ImprovRound {
  id         Int           @id @default(autoincrement())
  sessionId  Int
  session    ImprovSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderIndex Int           @default(0)
  cardData   Json
  voteResult String?
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime      @default(now())

  @@index([sessionId, orderIndex])
}

// ============ KAZ CHAT (live tutor) =============

model KazChatSession {
  id         Int              @id @default(autoincrement())
  userId     Int
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonSlug String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  messages   KazChatMessage[]

  @@unique([userId, lessonSlug])
  @@index([userId])
}

model KazChatMessage {
  id        Int            @id @default(autoincrement())
  sessionId Int
  session   KazChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String         @db.Text
  actIndex  Int?
  createdAt DateTime       @default(now())

  @@index([sessionId, createdAt])
}

// ============ PUSH NOTIFICATIONS (Web Push + futur Expo) =============

model PushSubscription {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String?
  auth       String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// ============ FRIDAY (Hermes home agent bridge) =============
// Pont chat entre Mission Control et l'agent Hermes domestique de Martin.
// Phase 1 : Martin only (admin). Phase 2 : kids restreints via FRIDAY policy.

model FridayConversation {
  id            Int             @id @default(autoincrement())
  userId        Int
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String          @default("Nouvelle conversation")
  pinned        Boolean         @default(false)
  archivedAt    DateTime?
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      FridayMessage[]

  @@index([userId, archivedAt, lastMessageAt])
}

model FridayMessage {
  id             Int                @id @default(autoincrement())
  conversationId Int
  conversation   FridayConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant" | "system"
  content        String             @db.Text
  metadata       Json? // raw FRIDAY response, tool calls, sources, etc.
  errorMessage   String?            @db.Text
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
}

// File d'attente pull-mode : messages user en attente d'être consommés par FRIDAY.
// FRIDAY long-polls /api/friday/poll, claim un pending, traite, POST sa réponse à
// /api/friday/webhook avec pendingId. Une fois respondedAt set, le pending est
// archivé (mais on le garde pour debug / replay).
model FridayPendingMessage {
  id             Int       @id @default(autoincrement())
  userId         Int
  conversationId Int
  payload        Json // user, conversation, message, history, context — ce que FRIDAY reçoit
  claimedAt      DateTime?
  respondedAt    DateTime?
  errorMessage   String?   @db.Text
  createdAt      DateTime  @default(now())

  @@index([claimedAt, respondedAt, createdAt])
}

// ============ MESSAGERIE FAMILIALE =============

model Conversation {
  id            Int                       @id @default(autoincrement())
  slug          String?                   @unique
  title         String?
  createdById   Int?
  createdAt     DateTime                  @default(now())
  lastMessageAt DateTime                  @default(now())
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int               @id @default(autoincrement())
  conversationId Int
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       Int
  author         User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String            @db.Text
  imageData      String?           @db.Text // data:image/webp;base64,... (Phase 3 image attachments)
  imageWidth     Int?
  imageHeight    Int?
  audioData      String?           @db.Text // data:audio/mpeg;base64,... (audio attachments)
  audioType      String? // mime: audio/mpeg, audio/mp3, etc.
  audioName      String? // filename original (pour download)
  // Reply-to (pour repondre a un message specifique)
  replyToId      Int?
  replyTo        Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]         @relation("MessageReply")
  // Reactions (emoji)
  reactions      MessageReaction[]
  // V2.7 : read receipts par message (qui a lu, quand).
  reads          MessageRead[]
  createdAt      DateTime          @default(now())
  editedAt       DateTime?
  // V2.8 : soft-delete d'un message. Si != null, le body / blobs sont vides
  // et le client affiche "Message supprime".
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
}

// V2.7 : MessageRead — qui a lu quel message, quand. Cree en bulk par
// POST /conversations/:id/read (createMany skipDuplicates).
// Utilise pour afficher les mini-avatars de lecture sous les messages
// envoyes par l'user courant (Thread.tsx).
model MessageRead {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
}

// Reaction emoji sur un message. Unique par (message, user, emoji) pour eviter double-react.
model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ===== HEIMDALL DROPS — modules pousses par FRIDAY (ou crees manuellement) =====
// Workflow : FRIDAY (ou admin) cree un Drop avec slug + titre + htmlContent.
// Admin grant access via DropAccess pour les users qui doivent voir le module.
// Le user peut ouvrir /drops/:slug si il a un DropAccess valide.

model Drop {
  id          Int          @id @default(autoincrement())
  slug        String       @unique // ex: 'spelling-quiz-v1'
  title       String
  description String?      @db.Text
  htmlContent String?      @db.Text // mockup HTML standalone
  iconEmoji   String?      @default("📦")
  realm       String       @default("FAMILY") // FAMILY | EDUCATIF | WORK
  status      String       @default("PENDING") // PENDING | APPROVED | DISABLED
  source      String? // 'friday' | 'manual' | etc.
  createdAt   DateTime     @default(now())
  approvedAt  DateTime?
  updatedAt   DateTime     @updatedAt
  accesses    DropAccess[]

  @@index([status, createdAt])
}

// Access par user pour un drop. Admin gere ces rows pour granter/revoker.
model DropAccess {
  id        Int      @id @default(autoincrement())
  dropId    Int
  drop      Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@unique([dropId, userId])
  @@index([userId])
}

// Scores soumis par les drops via MissionControl.submitScore(...).
// Sert au record perso et au leaderboard familial.
// `dropSlug` est libre (string), pas FK strict, pour eviter le cleanup en cascade
// si un drop est supprime puis re-cree (les scores survivent).
// `mode` est libre aussi (chaque drop choisit sa taxonomie, ex: 'addition', 'tables', 'mixte').
model DropScore {
  id         Int      @id @default(autoincrement())
  dropSlug   String
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode       String   @default("default")
  xp         Int      @default(0)
  correct    Int      @default(0)
  total      Int      @default(0)
  perfect    Boolean  @default(false)
  maxCombo   Int      @default(0)
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([dropSlug, mode, xp])
  @@index([userId, dropSlug, mode, xp])
}

// ============ CHANTIER CHALET — gestion de construction =============
// Module de suivi de la reconstruction du chalet (396 chemin du lac Mekinac,
// Trois-Rives). Un projet -> corps de metier, contacts, jalons (pre-construction
// + construction), soumissions (rattachees a un jalon + un contact), depenses,
// documents (plans/permis/photos, stockes en base64 dans fileData pour l'instant,
// migrables vers un bucket via fileUrl plus tard). Additif : ne touche a rien.

enum ChantierPhase {
  PRE_CONSTRUCTION
  CONSTRUCTION
}

enum JalonStatus {
  A_VENIR
  EN_COURS
  COMPLETE
  EN_RETARD
  BLOQUE
}

enum SoumissionStatus {
  RECUE
  EN_ANALYSE
  ACCEPTEE
  REFUSEE
}

enum DepenseType {
  DEPOT
  PARTIEL
  FINAL
  EXTRA
}

enum ChantierDocKind {
  PLAN
  PERMIS
  CONTRAT
  PHOTO
  RECU
  AUTRE
}

model ChantierProject {
  id          Int           @id @default(autoincrement())
  slug        String        @unique @default("chalet")
  name        String
  address     String?
  budgetTotal Int           @default(0) // dollars entiers
  startDate   DateTime?
  status      String        @default("EN_COURS")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  trades      Trade[]
  contacts    Contact[]
  jalons      Jalon[]
  soumissions Soumission[]
  depenses    Depense[]
  docs        ChantierDoc[]
  debourses   DebourseBanque[]
}

model Trade {
  id          Int             @id @default(autoincrement())
  projectId   Int
  project     ChantierProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  icon        String?         @default("hammer")
  color       String?         @default("#BA7517")
  budgetPrevu Int             @default(0)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  jalons      Jalon[]
  soumissions Soumission[]
  depenses    Depense[]
  docs        ChantierDoc[]

  @@index([projectId, order])
}

model Contact {
  id          Int             @id @default(autoincrement())
  projectId   Int
  project     ChantierProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company     String
  person      String?
  phone       String?
  email       String?
  website     String?
  facebook    String?
  instagram   String?
  address     String?
  rbq         String? // no de licence RBQ (entrepreneurs Quebec)
  trade       String? // metier libre (texte)
  status      String          @default("PRESSENTI") // PRESSENTI | SOUMISSION_RECUE | RETENU | ECARTE
  notes       String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  soumissions Soumission[]

  @@index([projectId])
}

model Jalon {
  id          Int             @id @default(autoincrement())
  projectId   Int
  project     ChantierProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tradeId     Int?
  trade       Trade?          @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  phase       ChantierPhase   @default(CONSTRUCTION)
  name        String
  description String?         @db.Text
  status      JalonStatus     @default(A_VENIR)
  progress    Int             @default(0) // 0-100
  dueDate     DateTime?
  doneDate    DateTime?
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  soumissions Soumission[]
  depenses    Depense[]
  docs        ChantierDoc[]

  @@index([projectId, phase, order])
}

model Soumission {
  id         Int              @id @default(autoincrement())
  projectId  Int
  project    ChantierProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tradeId    Int?
  trade      Trade?           @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  jalonId    Int?
  jalon      Jalon?           @relation(fields: [jalonId], references: [id], onDelete: SetNull)
  contactId  Int?
  contact    Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  label      String?
  amount     Int              @default(0) // dollars
  status     SoumissionStatus @default(RECUE)
  receivedAt DateTime?
  notes      String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  depenses   Depense[]
  docs       ChantierDoc[]

  @@index([projectId])
  @@index([jalonId])
  @@index([tradeId])
}

model Depense {
  id           Int             @id @default(autoincrement())
  projectId    Int
  project      ChantierProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tradeId      Int?
  trade        Trade?          @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  jalonId      Int?
  jalon        Jalon?          @relation(fields: [jalonId], references: [id], onDelete: SetNull)
  soumissionId Int?
  soumission   Soumission?     @relation(fields: [soumissionId], references: [id], onDelete: SetNull)
  label        String?
  amount       Int             @default(0)
  type         DepenseType     @default(PARTIEL)
  method       String?
  paidAt       DateTime?
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())

  @@index([projectId])
}

// Deboursés progressifs de la banque (financement construction).
// Chaque déboursé = une tranche versée par la banque à une étape du chantier.
model DebourseBanque {
  id         Int             @id @default(autoincrement())
  projectId  Int
  project    ChantierProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String // ex. "Déboursé 2 — toit fermé"
  amount     Int             @default(0) // dollars entiers
  condition  String?         @db.Text // condition exigée par la banque
  datePrevue DateTime?
  dateRecu   DateTime?
  recu       Boolean         @default(false)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([projectId, order])
}

// ============ BUDGET FAMILIAL =============
// Etat partage du budget familial (Martin + Marie-Josee). Un seul blob JSON
// versionne par updatedAt/updatedBy — le frontend (public/budget-app.html)
// charge et sauvegarde l'etat complet (revenus, depenses, previsions).
// Les donnees par defaut vivent dans src/routes/budget.js (jamais dans le
// HTML public). Additif : ne touche a rien d'existant.

model BudgetState {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @default("famille")
  data      Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChantierDoc {
  id           Int             @id @default(autoincrement())
  projectId    Int
  project      ChantierProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tradeId      Int?
  trade        Trade?          @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  jalonId      Int?
  jalon        Jalon?          @relation(fields: [jalonId], references: [id], onDelete: SetNull)
  soumissionId Int?
  soumission   Soumission?     @relation(fields: [soumissionId], references: [id], onDelete: SetNull)
  kind         ChantierDocKind @default(AUTRE)
  title        String
  fileData     String?         @db.Text // data:...;base64,... (photos compressees / petits PDF)
  fileUrl      String? // alternative : lien externe (migration bucket future)
  mimeType     String?
  width        Int?
  height       Int?
  takenAt      DateTime?
  createdAt    DateTime        @default(now())

  @@index([projectId])
  @@index([jalonId])
}
